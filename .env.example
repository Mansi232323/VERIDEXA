# Copy this file to .env and fill in values. The app runs perfectly
# well with NONE of these set — the AI Analyst uses a validated
# rule-based query engine by default, not an external LLM.
#
# Only set these if you want to enable optional LLM-powered rephrasing
# of insights (see modules/ai_analyzer.py — USE_LLM_PHRASING flag).

LLM_PROVIDER=none
# Supported values: none | groq | openai | anthropic | ollama
LLM_API_KEY=
LLM_MODEL=
# Only used when LLM_PROVIDER=ollama (points at a local `ollama serve`).
LLM_BASE_URL=http://localhost:11434

# Maximum size (in MB) accepted by the Upload & Clean page.
# Must also be raised in .streamlit/config.toml (server.maxUploadSize),
# since Streamlit enforces its own limit before this one is checked.
UPLOAD_MAX_MB=5120
